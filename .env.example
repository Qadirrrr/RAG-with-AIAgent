# Root Configuration (copy to .env and fill in real values; never commit real keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Database: Postgres when set, otherwise local SQLite file ./data/app.db
DATABASE_URL=

# Auth: long random secret for JWT signing. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# CORS: comma-separated allowed origins, or * for local development
CORS_ORIGINS=*

# Email that becomes super-admin on signup (leave empty to disable)
SUPER_ADMIN_EMAIL=

VITE_API_BASE_URL=http://localhost:8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
HOST=0.0.0.0
PORT=8000
