# Self-hosted Ollama Configuration (the only AI provider, no cloud keys needed)
# Run Ollama and pull the models:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
BGE_EMBEDDING_MODEL=bge-m3

# RAG chunking and retrieval tuning
CHUNK_WORDS=80
CHUNK_WORD_OVERLAP=15
RETRIEVAL_K=8
CONTEXT_NEIGHBORS=1
CONTEXT_MAX_CHARS=4500

# Storage paths
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads

CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000
