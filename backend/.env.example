# AI Provider Configuration
# Set your Google Gemini API Key here (Free tier available at https://aistudio.google.com)
# Use a placeholder only in this example file. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI Configuration (Optional fallback if you prefer OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Self-hosted Ollama Configuration (no cloud API key needed)
# Install Ollama on the server, then: ollama pull qwen2.5:7b
# Chatbots with provider "ollama" use this endpoint and need no Gemini/OpenAI key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# NOTE: the current production server (2 GB RAM, no GPU) is too small for
# qwen2.5:7b. Use a server with at least 8 GB RAM before switching the
# default provider to ollama. Gemini keeps working until then.

# Embedding provider: gemini (default), openai, or bge
# bge uses the self-hosted BGE model through Ollama (ollama pull bge-m3)
EMBEDDING_PROVIDER=gemini
BGE_EMBEDDING_MODEL=bge-m3

# Agent mode: maximum tool-calling steps per answer for chatbots in "agent" mode
AGENT_MAX_STEPS=5

# Database: Postgres when set, otherwise local SQLite file ./data/app.db
# Example Postgres: postgresql+psycopg2://user:password@localhost:5432/rag_saas
DATABASE_URL=

# Auth: long random secret for JWT signing. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# CORS: comma-separated allowed origins, or * for local development
CORS_ORIGINS=*

# Email that becomes super-admin on signup (leave empty to disable)
SUPER_ADMIN_EMAIL=

# Vector Database and Upload Settings
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
HOST=0.0.0.0
PORT=8000
