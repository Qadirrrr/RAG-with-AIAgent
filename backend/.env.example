# Self-hosted Ollama Configuration (the only AI provider, no cloud keys)
# Install Ollama on the server first, then pull the chat and embedding models:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# NOTE: qwen2.5:7b needs a server with at least 8 GB RAM and runs on CPU
# when there is no GPU, so answers are slower than a cloud model. For a
# smaller server use OLLAMA_MODEL=qwen2.5:3b.

# Embeddings: self-hosted BGE through Ollama (ollama pull bge-m3)
EMBEDDING_PROVIDER=bge
BGE_EMBEDDING_MODEL=bge-m3

# Agent mode: maximum tool-calling steps per answer for chatbots in "agent" mode
AGENT_MAX_STEPS=5

# Database: Postgres when set, otherwise local SQLite file ./data/app.db
# Example Postgres: postgresql+psycopg2://user:password@localhost:5432/rag_saas
DATABASE_URL=

# Auth: long random secret for JWT signing. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# CORS: comma-separated allowed origins, or * for local development
CORS_ORIGINS=*

# Email that becomes super-admin on signup (leave empty to disable)
SUPER_ADMIN_EMAIL=

# Vector Database and Upload Settings
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
HOST=0.0.0.0
PORT=8000
